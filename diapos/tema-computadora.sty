\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tema-computadora}[2026/09/21 tema beamer estilo tecnico/monoespaciado]

\RequirePackage{inconsolata}
\RequirePackage{xcolor}

% fuente monoespaciada en todo el documento (titulos, cuerpo, todo)
\renewcommand*{\familydefault}{\ttdefault}

% paleta: gris oscuro neutro de fondo, texto casi blanco, acento azul
% tipo esquematico/plano tecnico (como el esquematico del modulo Parla),
% y un acento cobre/naranja tipo pista de PCB para enfasis
\definecolor{compufondo}{HTML}{14161A}
\definecolor{compuprimario}{HTML}{D8DADD}
\definecolor{compuacento}{HTML}{4F9FD8}
\definecolor{compusecundario}{HTML}{6B7280}
\definecolor{compualerta}{HTML}{D97757}

\setbeamercolor{background canvas}{bg=compufondo}
\setbeamercolor{normal text}{fg=compuprimario, bg=compufondo}
\setbeamercolor{structure}{fg=compuacento}
\setbeamercolor{alerted text}{fg=compualerta}
\setbeamercolor{title}{fg=compuacento}
\setbeamercolor{subtitle}{fg=compuprimario}
\setbeamercolor{author}{fg=compuprimario}
\setbeamercolor{institute}{fg=compusecundario}
\setbeamercolor{date}{fg=compusecundario}
\setbeamercolor{frametitle}{fg=compuacento, bg=compufondo}
\setbeamercolor{block title}{fg=compuacento, bg=compufondo}
\setbeamercolor{block body}{fg=compuprimario, bg=compufondo}
\setbeamercolor{item}{fg=compuacento}
\setbeamercolor{section in toc}{fg=compuprimario}
\setbeamercolor{footline}{fg=compusecundario, bg=compufondo}
\setbeamercolor{page number in head/foot}{fg=compusecundario}

\setbeamertemplate{navigation symbols}{}

% bullets simples, geometricos, sin simulacion de shell
\setbeamertemplate{itemize item}{\textcolor{compuacento}{\scriptsize\textbullet}}
\setbeamertemplate{itemize subitem}{\textcolor{compusecundario}{--}}
\setbeamertemplate{itemize subsubitem}{\textcolor{compusecundario}{\textperiodcentered}}

% titulo de cada diapositiva: texto en acento + linea fina debajo
\setbeamertemplate{frametitle}{%
  \vspace{0.6em}
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}
  \vspace{0.2em}
  {\color{compusecundario}\rule{\linewidth}{0.4pt}}
  \vspace{0.3em}
}

% pie de pagina: autor a la izquierda, numero de diapositiva a la derecha
\setbeamertemplate{footline}{%
  \hbox{%
    \begin{beamercolorbox}[wd=\paperwidth, ht=2.5ex, dp=1.5ex, leftskip=1em, rightskip=1em]{footline}
      \textcolor{compusecundario}{\insertshortauthor}
      \hfill
      \textcolor{compusecundario}{\insertframenumber\,/\,\inserttotalframenumber}
    \end{beamercolorbox}%
  }
}

% pagina de titulo: titulo/subtitulo, linea fina, y datos en formato
% "etiqueta   valor", como una hoja de datos tecnica
\setbeamertemplate{title page}{%
  \vspace{1.5em}
  {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
  {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}

  \vspace{0.4em}
  {\color{compusecundario}\rule{0.3\linewidth}{0.4pt}}
  \vspace{1.2em}

  {\small
    \textcolor{compusecundario}{autor}\hspace{1em}{\usebeamercolor[fg]{author}\insertauthor}\par
    \textcolor{compusecundario}{institución}\hspace{1em}{\usebeamercolor[fg]{institute}\insertinstitute}\par
    \textcolor{compusecundario}{fecha}\hspace{1em}{\usebeamercolor[fg]{date}\insertdate}\par
  }
}

\endinput
